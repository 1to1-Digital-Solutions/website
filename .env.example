# Copy to .env.local and fill in. Never commit real values.

# Contact form email (https://resend.com). Without these three, /api/contact answers 500.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Website <hello@example.com>".
RESEND_FROM_EMAIL=
# Inbox that receives the lead notifications.
CONTACT_TO_EMAIL=

# Optional: Google Apps Script web app that appends each lead to a sheet.
# If either is empty, the sheet step is skipped.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Optional: Google Analytics 4 measurement ID. Loaded only after cookie consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: extra origin accepted by /api/contact (e.g. a custom preview domain).
NEXT_PUBLIC_SITE_URL=
