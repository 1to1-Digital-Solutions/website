{
  "name": "@1to1/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Copia del paquete @1to1/ui (../design-system) para que Vercel pueda compilar la landing. Se actualiza con pnpm sync:ui; no editar a mano.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./theme.css": "./src/styles/theme.css",
    "./components.css": "./src/styles/components.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./tokens.json": "./tokens/tokens.json",
    "./assets/*": "./assets/*"
  },
  "files": [
    "src",
    "assets",
    "tokens"
  ],
  "scripts": {},
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "react-dom": ">=18"
  }
}
